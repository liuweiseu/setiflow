manifest {
    name            = 'seti-nextflow-demo'
    description     = 'Nextflow pipeline for merging and plotting SETI ON/OFF spike data with setisignals'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    // One-time setup steps, off by default (already installed / extracted locally).
    // Enable explicitly with --install_tool true / --extract_data true when needed.
    install_tool = false
    extract_data = false
}

process {
    withLabel: 'data_processing' {
        cpus = 8
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
}
